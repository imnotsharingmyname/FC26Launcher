{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "EA SPORTS FC 26",
  "repo": "imnotsharingmyname/FC26Launcher",
  "inputs": [
    {
      "id": "game",
      "label": "Your EA SPORTS FC 26 Switch base game (.nsp or .xci)",
      "role": "game",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nsp",
            "xci"
          ]
        }
      ]
    },
    {
      "id": "update",
      "label": "Your FC 26 1.86.1233 update (v1179648, .nsp)",
      "role": "update",
      "formats": [
        {
          "type": "file",
          "extensions": [
            "nsp"
          ]
        }
      ]
    },
    {
      "id": "keys",
      "label": "Your Nintendo Switch prod.keys",
      "role": "key",
      "shared": "switch.prod-keys"
    }
  ],
  "start": {
    "program": [
      "FC 26 Launcher.app/Contents/MacOS/FC26Launcher"
    ],
    "args": [
      "--play"
    ]
  },
  "prepare": {
    "program": [
      "FC 26 Launcher.app/Contents/MacOS/FC26Launcher"
    ],
    "args": [
      "--prepare",
      "--game={input:game}",
      "--update={input:update}",
      "--keys={input:keys}"
    ],
    "label": "Checking and building EA SPORTS FC 26",
    "done": [
      "{data}/prepared",
      "{data}/EA-Sports-FC-26.app/Contents/MacOS/nxnative",
      "{data}/EA-Sports-FC-26.app/Contents/MacOS/dmhost",
      "{data}/EA-Sports-FC-26.app/Contents/Resources/romfs.img",
      "{data}/EA-Sports-FC-26.app/Contents/Resources/dm/launcher.json"
    ]
  },
  "config": [
    {
      "format": "json",
      "file": [
        {
          "path": "{data}/settings.json"
        }
      ]
    }
  ],
  "saves": [
    "{data}/saves",
    "{data}/settings.json"
  ],
  "folders": {
    "saves": [
      {
        "path": "{data}/saves"
      }
    ],
    "logs": [
      {
        "path": "{data}/runtime-home/Library/Logs/nxnative"
      }
    ],
    "build_logs": [
      {
        "path": "{data}/cache/build/logs"
      }
    ]
  },
  "system": {
    "macos": {
      "version": "26.6"
    }
  },
  "settings": [
    {
      "id": "DM_FPS_TARGET",
      "label": "Frame rate",
      "group": "Game",
      "help": "30 FPS is the original console rate. Use a 120 Hz display for 120 FPS.",
      "defaults": {
        "DM_FPS_TARGET": "\"60\""
      },
      "choices": [
        {"label": "30 fps", "set": {"DM_FPS_TARGET": "\"30\""}},
        {"label": "60 fps", "set": {"DM_FPS_TARGET": "\"60\""}},
        {"label": "120 fps", "set": {"DM_FPS_TARGET": "\"120\""}}
      ]
    },
    {
      "id": "DM_OPMODE",
      "label": "Console mode",
      "group": "Game",
      "help": "Simulate docked or handheld mode",
      "defaults": {
        "DM_OPMODE": "\"1\""
      },
      "choices": [
        {"label": "Docked", "set": {"DM_OPMODE": "\"1\""}},
        {"label": "Handheld", "set": {"DM_OPMODE": "\"0\""}}
      ]
    },
    {
      "id": "DM_PRESENT_UPSCALE",
      "label": "Upscaling",
      "group": "Game",
      "help": "MetalFX upscaling uses more GPU time and can increase heat",
      "defaults": {
        "DM_PRESENT_UPSCALE": "\"off\""
      },
      "choices": [
        {"label": "Standard", "set": {"DM_PRESENT_UPSCALE": "\"off\""}},
        {"label": "MetalFX", "set": {"DM_PRESENT_UPSCALE": "\"metalfx\""}}
      ]
    },
    {
      "id": "DM_LANG",
      "label": "Game language",
      "group": "Game",
      "help": "Game UI language",
      "defaults": {
        "DM_LANG": "\"en-GB\""
      },
      "choices": [
        {"label": "British English", "set": {"DM_LANG": "\"en-GB\""}},
        {"label": "Japanese", "set": {"DM_LANG": "\"ja\""}},
        {"label": "French", "set": {"DM_LANG": "\"fr\""}},
        {"label": "German", "set": {"DM_LANG": "\"de\""}},
        {"label": "Latin American Spanish", "set": {"DM_LANG": "\"es-419\""}},
        {"label": "Spanish", "set": {"DM_LANG": "\"es\""}},
        {"label": "Italian", "set": {"DM_LANG": "\"it\""}},
        {"label": "Dutch", "set": {"DM_LANG": "\"nl\""}},
        {"label": "Portuguese", "set": {"DM_LANG": "\"pt\""}},
        {"label": "Russian", "set": {"DM_LANG": "\"ru\""}},
        {"label": "Korean", "set": {"DM_LANG": "\"ko\""}},
        {"label": "Traditional Chinese", "set": {"DM_LANG": "\"zh-Hant\""}},
        {"label": "Simplified Chinese", "set": {"DM_LANG": "\"zh-Hans\""}},
        {"label": "Brazilian Portuguese", "set": {"DM_LANG": "\"pt-BR\""}}
      ]
    },
    {
      "id": "DM_FULLSCREEN",
      "label": "Display mode",
      "group": "Game",
      "help": "Run in windowed or fullscreen mode",
      "defaults": {
        "DM_FULLSCREEN": "\"0\""
      },
      "choices": [
        {"label": "Window", "set": {"DM_FULLSCREEN": "\"0\""}},
        {"label": "Fullscreen", "set": {"DM_FULLSCREEN": "\"1\""}}
      ]
    },
    {
      "id": "DM_PRESENT_FILL",
      "label": "Screen fill",
      "group": "Game",
      "help": "Keep the original aspect ratio or stretch to fill the window.",
      "defaults": {
        "DM_PRESENT_FILL": "\"fit\""
      },
      "choices": [
        {"label": "Keep aspect ratio", "set": {"DM_PRESENT_FILL": "\"fit\""}},
        {"label": "Fill screen", "set": {"DM_PRESENT_FILL": "\"stretch\""}}
      ]
    },
    {
      "id": "DM_PAD_LAYOUT",
      "label": "Button layout",
      "group": "Controls",
      "help": "Match the Switch button positions or use Xbox button labels.",
      "defaults": {
        "DM_PAD_LAYOUT": "\"position\""
      },
      "choices": [
        {"label": "Switch positions", "set": {"DM_PAD_LAYOUT": "\"position\""}},
        {"label": "Xbox labels", "set": {"DM_PAD_LAYOUT": "\"xbox\""}}
      ]
    },
    {
      "id": "DM_RUMBLE",
      "label": "Game rumble",
      "group": "Controls",
      "help": "Enable controller rumble",
      "defaults": {
        "DM_RUMBLE": "\"1\""
      },
      "choices": [
        {"label": "On", "set": {"DM_RUMBLE": "\"1\""}},
        {"label": "Off", "set": {"DM_RUMBLE": "\"0\""}}
      ]
    },
    {
      "id": "DM_RUMBLE_GAIN",
      "label": "Rumble strength",
      "group": "Controls",
      "help": "Rumble intensity multiplier",
      "when": {
        "DM_RUMBLE": "\"1\""
      },
      "defaults": {
        "DM_RUMBLE_GAIN": "1.0"
      },
      "slider": {
        "key": "DM_RUMBLE_GAIN",
        "min": 0.0,
        "max": 3.0,
        "step": 0.1
      }
    },
    {
      "id": "DM_RUMBLE_MIN",
      "label": "Rumble cutoff",
      "group": "Controls",
      "help": "Minimum rumble threshold",
      "defaults": {
        "DM_RUMBLE_MIN": "0"
      },
      "slider": {
        "key": "DM_RUMBLE_MIN",
        "min": 0.0,
        "max": 0.9,
        "step": 0.05
      }
    },
    {
      "id": "DM_PRESENT_SNAP",
      "label": "Frame buffering",
      "group": "Performance",
      "help": "Up to one frame more display latency",
      "defaults": {
        "DM_PRESENT_SNAP": "\"0\""
      },
      "choices": [
        {"label": "On", "set": {"DM_PRESENT_SNAP": "\"1\""}},
        {"label": "Off", "set": {"DM_PRESENT_SNAP": "\"0\""}}
      ]
    },
    {
      "id": "DM_PSO_MTL4",
      "label": "Metal 4 pipelines",
      "group": "Performance",
      "help": "Keeps a pipeline archive; uses more memory",
      "defaults": {
        "DM_PSO_MTL4": "\"1\""
      },
      "choices": [
        {"label": "On", "set": {"DM_PSO_MTL4": "\"1\""}},
        {"label": "Off", "set": {"DM_PSO_MTL4": "\"0\""}}
      ]
    },
    {
      "id": "DM_PSO_PREBUILD",
      "label": "Pipeline prebuild",
      "group": "Performance",
      "help": "The first start waits a few minutes for it, once",
      "when": {
        "DM_PSO_MTL4": "\"1\""
      },
      "defaults": {
        "DM_PSO_PREBUILD": "\"1\""
      },
      "choices": [
        {"label": "On", "set": {"DM_PSO_PREBUILD": "\"1\""}},
        {"label": "Off", "set": {"DM_PSO_PREBUILD": "\"0\""}}
      ]
    },
    {
      "id": "DM_NVN_ENC_THREAD",
      "label": "Encode thread",
      "group": "Performance",
      "help": "Use separate encode thread",
      "defaults": {
        "DM_NVN_ENC_THREAD": "\"0\""
      },
      "choices": [
        {"label": "On", "set": {"DM_NVN_ENC_THREAD": "\"1\""}},
        {"label": "Off", "set": {"DM_NVN_ENC_THREAD": "\"0\""}}
      ]
    },
    {
      "id": "DM_FPS_HOLD",
      "label": "Hold frames when late",
      "group": "Performance",
      "help": "Hold frames when rendering is late",
      "defaults": {
        "DM_FPS_HOLD": "\"on\""
      },
      "choices": [
        {"label": "On", "set": {"DM_FPS_HOLD": "\"on\""}},
        {"label": "Off", "set": {"DM_FPS_HOLD": "\"off\""}}
      ]
    },
    {
      "id": "DM_METAL_HUD",
      "label": "Performance HUD",
      "group": "Performance",
      "help": "Show Metal performance HUD",
      "defaults": {
        "DM_METAL_HUD": "\"0\""
      },
      "choices": [
        {"label": "On", "set": {"DM_METAL_HUD": "\"1\""}},
        {"label": "Off", "set": {"DM_METAL_HUD": "\"0\""}}
      ]
    }
  ]
}
